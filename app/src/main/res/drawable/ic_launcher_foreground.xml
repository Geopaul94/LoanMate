<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ascending bars: growth toward debt-free. Thick round-capped
         strokes read as rounded pills. All within the adaptive safe zone. -->
    <path
        android:pathData="M40,75 L40,66"
        android:strokeWidth="12"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="60" android:endX="40" android:endY="80"
                android:startColor="#FFE7A64B" android:endColor="#FFEFB65E" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M54,75 L54,57"
        android:strokeWidth="12"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="50" android:endX="54" android:endY="80"
                android:startColor="#FFEFB65E" android:endColor="#FFF6C766" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M68,75 L68,49"
        android:strokeWidth="12"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="68" android:startY="42" android:endX="68" android:endY="80"
                android:startColor="#FFF6C766" android:endColor="#FFFFD77A" />
        </aapt:attr>
    </path>

    <!-- Rising arrow above the tallest bar -->
    <path
        android:pathData="M58,40 L68,30 L78,40"
        android:strokeColor="#FFFFF1D0"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
