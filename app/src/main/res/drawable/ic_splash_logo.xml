<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bars scaled up + centered for the splash icon slot. -->
    <path
        android:pathData="M36,80 L36,66"
        android:strokeWidth="15"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36" android:startY="58" android:endX="36" android:endY="86"
                android:startColor="#FFE7A64B" android:endColor="#FFEFB65E" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M54,80 L54,54"
        android:strokeWidth="15"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="46" android:endX="54" android:endY="86"
                android:startColor="#FFEFB65E" android:endColor="#FFF6C766" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M72,80 L72,42"
        android:strokeWidth="15"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="72" android:startY="34" android:endX="72" android:endY="86"
                android:startColor="#FFF6C766" android:endColor="#FFFFD77A" />
        </aapt:attr>
    </path>

    <!-- Rising arrow above the tallest bar -->
    <path
        android:pathData="M60,33 L72,21 L84,33"
        android:strokeColor="#FFFFF1D0"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
